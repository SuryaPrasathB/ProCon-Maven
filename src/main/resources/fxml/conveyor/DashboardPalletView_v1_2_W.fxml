<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Text?>

<VBox fx:id="palletRoot" prefHeight="220.0" prefWidth="226.0" spacing="5" xmlns="http://javafx.com/javafx/8.0.161"
      xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.tasnetwork.calibration.conveyor.dashboard.PalletController">

    <Text fx:id="palletName" fill="black" style="-fx-font-size: 14px; -fx-font-weight: bold;"
          text="Pallet Name" textAlignment="CENTER" wrappingWidth="220.0"/>

    <AnchorPane prefHeight="170.0" prefWidth="218.0">
        <children>
            <Rectangle fill="lightgray" height="160.0" layoutX="2.0" stroke="black" width="218.0"/>
            
            <!-- Top row -->
            <HBox alignment="CENTER" layoutX="8.0" layoutY="5.0" spacing="10">
                <!-- Position 1 -->
                <VBox alignment="CENTER" spacing="2">
                    <TextField fx:id="serial1" editable="false" maxWidth="60" promptText="Serial #" style="-fx-font-size: 10px;"/>
                    <StackPane>
                        <Rectangle fx:id="meter1" fill="FORESTGREEN" height="30" stroke="black" width="60"/>
                        <StackPane>
                            <Circle fill="white" radius="8" stroke="black"/>
                            <Text text="1"/>
                        </StackPane>
                    </StackPane>
                    <Text fx:id="errorCode1" style="-fx-font-size: 9px; -fx-fill: red;" text=""/>
                </VBox>

                <!-- Position 2 -->
                <VBox alignment="CENTER" spacing="2">
                    <TextField fx:id="serial2" editable="false" maxWidth="60" promptText="Serial #" style="-fx-font-size: 10px;"/>
                    <StackPane>
                        <Rectangle fx:id="meter2" fill="FORESTGREEN" height="30" stroke="black" width="60"/>
                        <StackPane>
                            <Circle fill="white" radius="8" stroke="black"/>
                            <Text text="2"/>
                        </StackPane>
                    </StackPane>
                    <Text fx:id="errorCode2" style="-fx-font-size: 9px; -fx-fill: red;" text=""/>
                </VBox>

                <!-- Position 3 -->
                <VBox alignment="CENTER" spacing="2">
                    <TextField fx:id="serial3" editable="false" maxWidth="60" promptText="Serial #" style="-fx-font-size: 10px;"/>
                    <StackPane>
                        <Rectangle fx:id="meter3" fill="FORESTGREEN" height="30" stroke="black" width="60"/>
                        <StackPane>
                            <Circle fill="white" radius="8" stroke="black"/>
                            <Text text="3"/>
                        </StackPane>
                    </StackPane>
                    <Text fx:id="errorCode3" style="-fx-font-size: 9px; -fx-fill: red;" text=""/>
                </VBox>
            </HBox>

            <!-- Bottom row -->
            <HBox alignment="CENTER" layoutX="8.0" layoutY="80.0" spacing="10">
                <!-- Position 4 -->
                <VBox alignment="CENTER" spacing="2">
                    <StackPane>
                        <Rectangle fx:id="meter4" fill="FORESTGREEN" height="30" stroke="black" width="60"/>
                        <StackPane>
                            <Circle fill="white" radius="8" stroke="black"/>
                            <Text text="4"/>
                        </StackPane>
                    </StackPane>
                    <TextField fx:id="serial4" editable="false" maxWidth="60" promptText="Serial #" style="-fx-font-size: 10px;"/>
                    <Text fx:id="errorCode4" style="-fx-font-size: 9px; -fx-fill: red;" text=""/>
                </VBox>

                <!-- Position 5 -->
                <VBox alignment="CENTER" spacing="2">
                    <StackPane>
                        <Rectangle fx:id="meter5" fill="FORESTGREEN" height="30" stroke="black" width="60"/>
                        <StackPane>
                            <Circle fill="white" radius="8" stroke="black"/>
                            <Text text="5"/>
                        </StackPane>
                    </StackPane>
                    <TextField fx:id="serial5" editable="false" maxWidth="60" promptText="Serial #" style="-fx-font-size: 10px;"/>
                    <Text fx:id="errorCode5" style="-fx-font-size: 9px; -fx-fill: red;" text=""/>
                </VBox>

                <!-- Position 6 -->
                <VBox alignment="CENTER" spacing="2">
                    <StackPane>
                        <Rectangle fx:id="meter6" fill="FORESTGREEN" height="30" stroke="black" width="60"/>
                        <StackPane>
                            <Circle fill="white" radius="8" stroke="black"/>
                            <Text text="6"/>
                        </StackPane>
                    </StackPane>
                    <TextField fx:id="serial6" editable="false" maxWidth="60" promptText="Serial #" style="-fx-font-size: 10px;"/>
                    <Text fx:id="errorCode6" style="-fx-font-size: 9px; -fx-fill: red;" text=""/>
                </VBox>
            </HBox>
        </children>
    </AnchorPane>

    <ProgressBar prefHeight="18.0" prefWidth="221.0" progress="0.0"/>

</VBox>
